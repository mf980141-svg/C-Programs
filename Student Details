#include <stdio.h>
#include <string.h>

#define MAX_STUDENTS 100
#define NAME_LEN 50

typedef struct {
    char name[NAME_LEN];
    int marks;
} Student;

static Student students[MAX_STUDENTS];
static int count = 0;

void add_student(void) {
    if (count >= MAX_STUDENTS) {
        printf("List is full.\n");
        return;
    }
    printf("Enter name: ");
    scanf(" %49[^\n]", students[count].name);
    printf("Enter marks (0-100): ");
    scanf("%d", &students[count].marks);
    count++;
    printf("Student added.\n");
}

void list_students(void) {
    if (count == 0) {
        printf("No students yet.\n");
        return;
    }
    printf("\n%-5s %-30s %s\n", "No.", "Name", "Marks");
    for (int i = 0; i < count; i++) {
        printf("%-5d %-30s %d\n", i + 1, students[i].name, students[i].marks);
    }
}

void show_average(void) {
    if (count == 0) {
        printf("No students yet.\n");
        return;
    }
    int total = 0;
    for (int i = 0; i < count; i++) {
        total += students[i].marks;
    }
    printf("Average marks: %.2f\n", (double)total / count);
}

int main(void) {
    int choice;

    do {
        printf("\n--- Student Records ---\n");
        printf("1. Add student\n");
        printf("2. List students\n");
        printf("3. Show average marks\n");
        printf("0. Exit\n");
        printf("Choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input.\n");
            return 1;
        }

        switch (choice) {
            case 1: add_student();   break;
            case 2: list_students(); break;
            case 3: show_average();  break;
            case 0: printf("Goodbye!\n"); break;
            default: printf("Invalid choice.\n");
        }
    } while (choice != 0);

    return 0;
}
